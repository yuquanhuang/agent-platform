AP_ENV=local
AP_SERVICE_NAME=api
AP_PUBLIC_BASE_URL=http://localhost:8000
AP_AUTH_MODE=mock
AP_LOG_LEVEL=INFO
AP_SECRET_BACKEND=env
AP_CONTRACT_BASELINE_ID=agent-platform-v1-dev-baseline-2026-08-r12
AP_API_HOST=127.0.0.1
AP_API_PORT=8000

# Local/test Mock OIDC claims are server-controlled. The client only sends
# Authorization: Bearer mock and cannot override tenant or role claims.
AP_MOCK_IDENTITY_ISSUER=https://mock.agent-platform.test
AP_MOCK_EXTERNAL_SUBJECT=mock-platform-admin
AP_MOCK_DISPLAY_NAME=Mock Platform Admin
AP_MOCK_EMAIL=mock-admin@example.test
AP_MOCK_PLATFORM_ROLES=["platform_admin"]
# AP_MOCK_ACTIVE_TENANT_ID=11111111-1111-4111-8111-111111111111
# AP_MOCK_MEMBERSHIP_VERSION=1

# Configure these references when their dependent services are enabled.
# AP_DATABASE_DSN_REF=secret://env/AP_SECRET_DATABASE_DSN
# AP_REDIS_DSN_REF=secret://env/AP_SECRET_REDIS_DSN
# AP_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# AP_OBJECT_STORAGE_BUCKET=agent-platform
# AP_OBJECT_STORAGE_CREDENTIAL_REF=secret://env/AP_SECRET_OBJECT_STORAGE_CREDENTIALS
# AP_OBJECT_STORAGE_CONNECT_TIMEOUT_SECONDS=5
# AP_OBJECT_STORAGE_READ_TIMEOUT_SECONDS=30
# AP_OBJECT_STORAGE_DOWNLOAD_CHUNK_BYTES=1048576
# AP_OBJECT_STORAGE_MAX_CONCURRENT_DOWNLOADS=32
# AP_OBJECT_STORAGE_DOWNLOAD_ACQUIRE_TIMEOUT_SECONDS=1
# AP_ARTIFACT_DOWNLOAD_REVOCATION_CHECK_INTERVAL_SECONDS=5
# AP_ARTIFACT_DOWNLOAD_MAX_DURATION_SECONDS=3600
# Exact browser-facing signed URL origins. Private MinIO must use an explicitly
# configured DNS name; IP literals and localhost are rejected.
# AP_ARTIFACT_PUBLIC_ORIGINS=["https://artifacts.example.test"]
# AP_TEMPORAL_ADDRESS=localhost:7233
# AP_TEMPORAL_NAMESPACE=agent-platform-local
# AP_TEMPORAL_CONNECT_TIMEOUT_SECONDS=10
# AP_WORKER_SHUTDOWN_GRACE_SECONDS=30
# AP_OUTBOX_BATCH_SIZE=50
# AP_OUTBOX_MAX_ATTEMPTS=10
# AP_SERVICE_SUBJECT_ID=00000000-0000-4000-8000-000000000001
# AP_WORKER_TENANT_LIMIT=100
# AP_EVENT_WORKER_POLL_INTERVAL_SECONDS=1
# AP_RECONCILIATION_WORKER_POLL_INTERVAL_SECONDS=30
# AP_SANDBOX_MANAGER_BASE_URL=http://sandbox-manager.agent-platform.svc.cluster.local:8000
# AP_SANDBOX_MANAGER_REQUEST_TIMEOUT_SECONDS=10
# AP_SANDBOX_MANAGER_ALLOWED_SUBJECT_IDS=["00000000-0000-4000-8000-000000000002"]
# AP_INTERNAL_SERVICE_TOKEN_ISSUER=https://identity.agent-platform.internal
# AP_INTERNAL_SERVICE_TOKEN_AUDIENCE=sandbox-manager
# AP_INTERNAL_SERVICE_TOKEN_KEY_ID=v1
# AP_INTERNAL_SERVICE_TOKEN_SIGNING_KEY_REF=secret://env/AP_SECRET_INTERNAL_SERVICE_TOKEN_SIGNING_KEY
# AP_INTERNAL_SERVICE_TOKEN_VERIFICATION_KEY_REF=secret://env/AP_SECRET_INTERNAL_SERVICE_TOKEN_VERIFICATION_KEY
# AP_INTERNAL_SERVICE_TOKEN_TTL_SECONDS=60
# AP_INTERNAL_SERVICE_TOKEN_CLOCK_SKEW_SECONDS=5
# AP_EXECUTION_TICKET_KEY_REF=secret://env/AP_SECRET_EXECUTION_TICKET_KEY
# AP_SSE_PAGE_SIZE=200
# AP_SSE_HEARTBEAT_SECONDS=15
# AP_SSE_POLL_INTERVAL_SECONDS=1
# AP_SSE_SEND_TIMEOUT_SECONDS=15
# AP_SANDBOX_PROVIDER_TIMEOUT_SECONDS=60
# Run hard-cap admission. Staging/production API composition requires all five.
# AP_RUN_MAX_NONTERMINAL_PER_TENANT=100
# AP_RUN_MAX_NONTERMINAL_PER_USER=10
# AP_RUN_MAX_NONTERMINAL_PER_AGENT=50
# AP_RUN_MAX_NONTERMINAL_AGENTSCOPE=100
# AP_RUN_MAX_NONTERMINAL_CODEX=20
# AP_OIDC_ISSUER=https://issuer.example.test
# AP_OIDC_CLIENT_ID=agent-platform
# AP_OIDC_CLIENT_SECRET_REF=secret://env/AP_SECRET_OIDC_CLIENT_SECRET
# AP_RUNTIME_CHECKPOINT_KEY_REF=secret://env/AP_SECRET_RUNTIME_CHECKPOINT_KEY
# AP_RUNTIME_CHECKPOINT_RETENTION_SECONDS=86400
# AP_RUNTIME_CHECKPOINT_MAX_STATE_BYTES=10485760
# AP_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# AP_METRICS_ALLOWED_NETWORKS=["127.0.0.1/32","::1/128"]

# Local shell values only. Kubernetes injects the same AP_SECRET_* names with
# secretKeyRef; do not commit real values.
# AP_SECRET_DATABASE_DSN=postgresql+asyncpg://localhost/agent_platform
# AP_SECRET_REDIS_DSN=redis://localhost:6379/0
# AP_SECRET_OBJECT_STORAGE_CREDENTIALS={"access_key":"minioadmin","secret_key":"replace"}
# AP_SECRET_OIDC_CLIENT_SECRET=replace
# AP_SECRET_RUNTIME_CHECKPOINT_KEY=replace-with-32-byte-base64url-key
# AP_SECRET_INTERNAL_SERVICE_TOKEN_SIGNING_KEY=replace-with-ed25519-private-key-pem
# AP_SECRET_INTERNAL_SERVICE_TOKEN_VERIFICATION_KEY=replace-with-ed25519-public-key-pem
# AP_SECRET_EXECUTION_TICKET_KEY=replace-with-at-least-32-random-bytes
