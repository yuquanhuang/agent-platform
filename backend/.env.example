AP_ENV=local
AP_SERVICE_NAME=api
AP_PUBLIC_BASE_URL=http://localhost:8000
AP_AUTH_MODE=mock
AP_LOG_LEVEL=INFO
AP_SECRET_BACKEND=local
AP_CONTRACT_BASELINE_ID=agent-platform-v1-dev-baseline-2026-08-r10
AP_API_HOST=127.0.0.1
AP_API_PORT=8000

# Local/test Mock OIDC claims are server-controlled. The client only sends
# Authorization: Bearer mock and cannot override tenant or role claims.
AP_MOCK_IDENTITY_ISSUER=https://mock.agent-platform.test
AP_MOCK_EXTERNAL_SUBJECT=mock-platform-admin
AP_MOCK_DISPLAY_NAME=Mock Platform Admin
AP_MOCK_EMAIL=mock-admin@example.test
AP_MOCK_PLATFORM_ROLES=["platform_admin"]
# AP_MOCK_ACTIVE_TENANT_ID=11111111-1111-4111-8111-111111111111
# AP_MOCK_MEMBERSHIP_VERSION=1

# Configure these references when their dependent services are enabled.
# AP_DATABASE_DSN_REF=secret://local/database
# AP_REDIS_DSN_REF=secret://local/redis
# AP_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# AP_OBJECT_STORAGE_BUCKET=agent-platform
# AP_OBJECT_STORAGE_CREDENTIAL_REF=secret://local/object-storage
