{
  "version": 1,
  "shared_paths": [
    "AGENTS.md",
    "Makefile",
    ".editorconfig",
    ".pre-commit-config.yaml",
    "harness",
    "scripts",
    "infra"
  ],
  "scopes": {
    "backend": {
      "path": "backend",
      "commands": {
        "format": ["{python}", "-m", "black", "."],
        "format_check": ["{python}", "-m", "black", "--check", "--diff", "."],
        "lint": ["{python}", "-m", "ruff", "check", "."],
        "typecheck": ["{python}", "-m", "pyright"],
        "test": ["{python}", "-m", "pytest"],
        "build": []
      },
      "check_steps": ["format_check", "lint", "typecheck", "test"]
    },
    "frontend": {
      "path": "frontend",
      "commands": {
        "format": ["pnpm", "format"],
        "format_check": ["pnpm", "format:check"],
        "lint": ["pnpm", "lint"],
        "typecheck": ["pnpm", "typecheck"],
        "test": ["pnpm", "test"],
        "build": ["pnpm", "build"]
      },
      "check_steps": ["format_check", "lint", "typecheck", "test", "build"]
    },
    "contracts": {
      "path": "contracts",
      "commands": {
        "contract_check": []
      },
      "check_steps": ["contract_check"],
      "affects": ["backend", "frontend"]
    }
  }
}
