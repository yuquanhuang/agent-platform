{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.local/schemas/run-event-v1.schema.json",
  "title": "Agent Platform RunEvent V1",
  "allOf": [
    { "$ref": "#/$defs/envelope" },
    {
      "oneOf": [
        { "$ref": "#/$defs/run_created_event" },
        { "$ref": "#/$defs/run_queued_event" },
        { "$ref": "#/$defs/run_started_event" },
        { "$ref": "#/$defs/text_message_start_event" },
        { "$ref": "#/$defs/text_delta_event" },
        { "$ref": "#/$defs/text_message_end_event" },
        { "$ref": "#/$defs/thinking_delta_event" },
        { "$ref": "#/$defs/plan_updated_event" },
        { "$ref": "#/$defs/tool_call_start_event" },
        { "$ref": "#/$defs/tool_call_args_event" },
        { "$ref": "#/$defs/tool_call_result_event" },
        { "$ref": "#/$defs/approval_required_event" },
        { "$ref": "#/$defs/approval_resolved_event" },
        { "$ref": "#/$defs/task_progress_event" },
        { "$ref": "#/$defs/artifact_created_event" },
        { "$ref": "#/$defs/warning_event" },
        { "$ref": "#/$defs/run_succeeded_event" },
        { "$ref": "#/$defs/run_failed_event" },
        { "$ref": "#/$defs/run_cancelled_event" },
        { "$ref": "#/$defs/run_timeout_event" }
      ]
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 3, "maxLength": 255 },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "event_id", "source_event_id", "tenant_id", "run_id",
        "session_id", "sequence_no", "event_type", "occurred_at", "recorded_at",
        "trace_id", "execution_attempt", "payload_version", "payload"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "event_id": { "$ref": "#/$defs/id" },
        "source_event_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "tenant_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "session_id": { "$ref": "#/$defs/id" },
        "sequence_no": { "type": "integer", "minimum": 1 },
        "event_type": {
          "enum": [
            "run_created", "run_queued", "run_started",
            "text_message_start", "text_delta", "text_message_end", "thinking_delta",
            "plan_updated", "tool_call_start", "tool_call_args", "tool_call_result",
            "approval_required", "approval_resolved", "task_progress", "artifact_created",
            "warning", "run_succeeded", "run_failed", "run_cancelled", "run_timeout"
          ]
        },
        "occurred_at": { "type": "string", "format": "date-time" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "trace_id": { "$ref": "#/$defs/id" },
        "execution_attempt": { "type": "integer", "minimum": 1 },
        "payload_version": { "const": "1.0" },
        "payload": { "type": "object" }
      }
    },
    "run_created_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["deployment_id", "snapshot_id"],
      "properties": { "deployment_id": { "$ref": "#/$defs/id" }, "snapshot_id": { "$ref": "#/$defs/id" } }
    },
    "run_queued_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["queue", "queued_at"],
      "properties": { "queue": { "type": "string", "maxLength": 128 }, "queued_at": { "type": "string", "format": "date-time" } }
    },
    "run_started_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime_type", "runtime_target_id"],
      "properties": { "runtime_type": { "enum": ["agentscope", "codex"] }, "runtime_target_id": { "$ref": "#/$defs/id" }, "sandbox_id": { "type": ["string", "null"] } }
    },
    "text_message_start_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["message_id", "role"],
      "properties": { "message_id": { "$ref": "#/$defs/id" }, "role": { "enum": ["assistant", "tool"] } }
    },
    "text_delta_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["message_id", "delta"],
      "properties": { "message_id": { "$ref": "#/$defs/id" }, "delta": { "type": "string", "minLength": 1, "maxLength": 65536 } }
    },
    "text_message_end_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["message_id", "finish_reason"],
      "properties": { "message_id": { "$ref": "#/$defs/id" }, "finish_reason": { "enum": ["stop", "length", "tool_call", "cancelled", "error", "unknown"] } }
    },
    "thinking_delta_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["message_id", "delta", "visibility"],
      "properties": { "message_id": { "$ref": "#/$defs/id" }, "delta": { "type": "string", "minLength": 1, "maxLength": 65536 }, "visibility": { "enum": ["debug_only", "authorized_user"] } }
    },
    "plan_step": {
      "type": "object", "additionalProperties": false,
      "required": ["step_id", "title", "status"],
      "properties": { "step_id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "maxLength": 1000 }, "status": { "enum": ["pending", "in_progress", "completed", "failed", "cancelled"] } }
    },
    "plan_updated_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "steps"],
      "properties": { "plan_id": { "$ref": "#/$defs/id" }, "steps": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/plan_step" } } }
    },
    "tool_call_start_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_call_id", "tool_name", "arguments_summary"],
      "properties": { "tool_call_id": { "$ref": "#/$defs/id" }, "tool_name": { "type": "string", "maxLength": 255 }, "arguments_summary": { "type": "string", "maxLength": 4000 } }
    },
    "tool_call_args_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_call_id", "arguments_patch"],
      "properties": { "tool_call_id": { "$ref": "#/$defs/id" }, "arguments_patch": { "type": "string", "maxLength": 65536 } }
    },
    "artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id"],
      "properties": { "artifact_id": { "$ref": "#/$defs/id" }, "name": { "type": ["string", "null"], "maxLength": 255 } }
    },
    "tool_call_result_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_call_id", "status", "result_summary", "artifact_refs"],
      "properties": {
        "tool_call_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["succeeded", "failed", "denied", "cancelled"] },
        "result_summary": { "type": "string", "maxLength": 8000 },
        "artifact_refs": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/artifact_ref" } },
        "error_code": { "type": ["string", "null"], "maxLength": 64 }
      }
    },
    "approval_required_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["approval_id", "tool_name", "parameter_digest", "expires_at"],
      "properties": { "approval_id": { "$ref": "#/$defs/id" }, "tool_name": { "type": "string", "maxLength": 255 }, "parameter_digest": { "type": "string", "maxLength": 128 }, "expires_at": { "type": "string", "format": "date-time" } }
    },
    "approval_resolved_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["approval_id", "decision", "decided_by"],
      "properties": { "approval_id": { "$ref": "#/$defs/id" }, "decision": { "enum": ["APPROVED", "REJECTED", "EXPIRED", "CANCELLED"] }, "decided_by": { "$ref": "#/$defs/id" } }
    },
    "task_progress_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "current", "total", "message"],
      "properties": { "task_id": { "$ref": "#/$defs/id" }, "current": { "type": "number", "minimum": 0 }, "total": { "type": "number", "exclusiveMinimum": 0 }, "message": { "type": "string", "maxLength": 2000 } }
    },
    "artifact_created_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "name", "content_type", "size"],
      "properties": { "artifact_id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "maxLength": 255 }, "content_type": { "type": "string", "maxLength": 255 }, "size": { "type": "integer", "minimum": 0 }, "required_output": { "type": "boolean", "default": false } }
    },
    "warning_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message"],
      "properties": { "code": { "type": "string", "maxLength": 64 }, "message": { "type": "string", "maxLength": 4000 }, "details": { "type": "object", "maxProperties": 20, "additionalProperties": { "type": ["string", "number", "boolean", "null"] } } }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "estimated"],
      "properties": { "input_tokens": { "type": "integer", "minimum": 0 }, "output_tokens": { "type": "integer", "minimum": 0 }, "reasoning_tokens": { "type": "integer", "minimum": 0, "default": 0 }, "estimated": { "type": "boolean" } }
    },
    "run_succeeded_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["result_message_id", "usage", "warnings"],
      "properties": { "result_message_id": { "$ref": "#/$defs/id" }, "usage": { "$ref": "#/$defs/usage" }, "warnings": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 64 } }, "result_quality": { "enum": ["NORMAL", "SUCCEEDED_WITH_WARNINGS"] } }
    },
    "run_failed_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["error_code", "message", "retryable"],
      "properties": { "error_code": { "type": "string", "maxLength": 64 }, "message": { "type": "string", "maxLength": 4000 }, "retryable": { "type": "boolean" } }
    },
    "run_cancelled_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["reason", "cancelled_by"],
      "properties": { "reason": { "type": "string", "maxLength": 1000 }, "cancelled_by": { "$ref": "#/$defs/id" }, "forced": { "type": "boolean", "default": false } }
    },
    "run_timeout_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["timeout_seconds", "stage"],
      "properties": { "timeout_seconds": { "type": "integer", "minimum": 1 }, "stage": { "enum": ["queue", "prepare", "runtime", "approval", "artifact", "cleanup"] } }
    },
    "event_variant_template": { "type": "object" },
    "run_created_event": { "properties": { "event_type": { "const": "run_created" }, "payload": { "$ref": "#/$defs/run_created_payload" } } },
    "run_queued_event": { "properties": { "event_type": { "const": "run_queued" }, "payload": { "$ref": "#/$defs/run_queued_payload" } } },
    "run_started_event": { "properties": { "event_type": { "const": "run_started" }, "payload": { "$ref": "#/$defs/run_started_payload" } } },
    "text_message_start_event": { "properties": { "event_type": { "const": "text_message_start" }, "payload": { "$ref": "#/$defs/text_message_start_payload" } } },
    "text_delta_event": { "properties": { "event_type": { "const": "text_delta" }, "payload": { "$ref": "#/$defs/text_delta_payload" } } },
    "text_message_end_event": { "properties": { "event_type": { "const": "text_message_end" }, "payload": { "$ref": "#/$defs/text_message_end_payload" } } },
    "thinking_delta_event": { "properties": { "event_type": { "const": "thinking_delta" }, "payload": { "$ref": "#/$defs/thinking_delta_payload" } } },
    "plan_updated_event": { "properties": { "event_type": { "const": "plan_updated" }, "payload": { "$ref": "#/$defs/plan_updated_payload" } } },
    "tool_call_start_event": { "properties": { "event_type": { "const": "tool_call_start" }, "payload": { "$ref": "#/$defs/tool_call_start_payload" } } },
    "tool_call_args_event": { "properties": { "event_type": { "const": "tool_call_args" }, "payload": { "$ref": "#/$defs/tool_call_args_payload" } } },
    "tool_call_result_event": { "properties": { "event_type": { "const": "tool_call_result" }, "payload": { "$ref": "#/$defs/tool_call_result_payload" } } },
    "approval_required_event": { "properties": { "event_type": { "const": "approval_required" }, "payload": { "$ref": "#/$defs/approval_required_payload" } } },
    "approval_resolved_event": { "properties": { "event_type": { "const": "approval_resolved" }, "payload": { "$ref": "#/$defs/approval_resolved_payload" } } },
    "task_progress_event": { "properties": { "event_type": { "const": "task_progress" }, "payload": { "$ref": "#/$defs/task_progress_payload" } } },
    "artifact_created_event": { "properties": { "event_type": { "const": "artifact_created" }, "payload": { "$ref": "#/$defs/artifact_created_payload" } } },
    "warning_event": { "properties": { "event_type": { "const": "warning" }, "payload": { "$ref": "#/$defs/warning_payload" } } },
    "run_succeeded_event": { "properties": { "event_type": { "const": "run_succeeded" }, "payload": { "$ref": "#/$defs/run_succeeded_payload" } } },
    "run_failed_event": { "properties": { "event_type": { "const": "run_failed" }, "payload": { "$ref": "#/$defs/run_failed_payload" } } },
    "run_cancelled_event": { "properties": { "event_type": { "const": "run_cancelled" }, "payload": { "$ref": "#/$defs/run_cancelled_payload" } } },
    "run_timeout_event": { "properties": { "event_type": { "const": "run_timeout" }, "payload": { "$ref": "#/$defs/run_timeout_payload" } } },
    "runtime_event_candidate": {
      "allOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_event_id", "event_type", "occurred_at", "payload_version", "payload"],
          "properties": {
            "source_event_id": { "type": "string", "minLength": 1, "maxLength": 255 },
            "event_type": { "$ref": "#/$defs/envelope/properties/event_type" },
            "occurred_at": { "type": "string", "format": "date-time" },
            "payload_version": { "const": "1.0" },
            "payload": { "type": "object" }
          }
        },
        {
          "oneOf": [
            { "$ref": "#/$defs/run_created_event" },
            { "$ref": "#/$defs/run_queued_event" },
            { "$ref": "#/$defs/run_started_event" },
            { "$ref": "#/$defs/text_message_start_event" },
            { "$ref": "#/$defs/text_delta_event" },
            { "$ref": "#/$defs/text_message_end_event" },
            { "$ref": "#/$defs/thinking_delta_event" },
            { "$ref": "#/$defs/plan_updated_event" },
            { "$ref": "#/$defs/tool_call_start_event" },
            { "$ref": "#/$defs/tool_call_args_event" },
            { "$ref": "#/$defs/tool_call_result_event" },
            { "$ref": "#/$defs/approval_required_event" },
            { "$ref": "#/$defs/approval_resolved_event" },
            { "$ref": "#/$defs/task_progress_event" },
            { "$ref": "#/$defs/artifact_created_event" },
            { "$ref": "#/$defs/warning_event" },
            { "$ref": "#/$defs/run_succeeded_event" },
            { "$ref": "#/$defs/run_failed_event" },
            { "$ref": "#/$defs/run_cancelled_event" },
            { "$ref": "#/$defs/run_timeout_event" }
          ]
        }
      ]
    }
  }
}
