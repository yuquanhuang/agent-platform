{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.local/schemas/bundle-manifest-v1.schema.json",
  "title": "Agent Platform Runtime Bundle Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "bundle_id", "tenant_id", "agent_id", "snapshot_id",
    "runtime_type", "compiler", "files", "bindings", "security", "content_hash", "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "bundle_id": { "$ref": "#/$defs/id" },
    "tenant_id": { "$ref": "#/$defs/id" },
    "agent_id": { "$ref": "#/$defs/id" },
    "snapshot_id": { "$ref": "#/$defs/id" },
    "runtime_type": { "enum": ["agentscope", "codex"] },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "enum": ["AgentScopeBundleCompiler", "CodexBundleCompiler"] },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/file" }
    },
    "bindings": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/binding" }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permission_policy_hash", "sandbox_policy_hash", "secret_refs"],
      "properties": {
        "permission_policy_hash": { "$ref": "#/$defs/hash" },
        "sandbox_policy_hash": { "$ref": "#/$defs/hash" },
        "secret_refs": { "type": "array", "uniqueItems": true, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
      }
    },
    "content_hash": { "$ref": "#/$defs/hash" },
    "signature_ref": { "type": ["string", "null"], "maxLength": 2048 },
    "sbom_ref": { "type": ["string", "null"], "maxLength": 2048 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 3, "maxLength": 255 },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash", "size_bytes", "mode", "source_type"],
      "properties": {
        "path": { "$ref": "#/$defs/relative_path" },
        "hash": { "$ref": "#/$defs/hash" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "mode": { "type": "string", "pattern": "^0[0-7]{3}$" },
        "source_type": { "enum": ["generated", "prompt", "skill", "mcp", "runtime_config", "static_asset"] },
        "source_id": { "type": ["string", "null"], "maxLength": 255 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_type", "resource_id", "version_id", "content_hash"],
      "properties": {
        "resource_type": { "enum": ["prompt", "skill", "mcp", "model", "knowledge", "sandbox", "agent"] },
        "resource_id": { "$ref": "#/$defs/id" },
        "version_id": { "$ref": "#/$defs/id" },
        "content_hash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
